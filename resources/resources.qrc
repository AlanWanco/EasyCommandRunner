<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/res">
        <file>app_icon.png</file>
        <file>fonts/SarasaMonoSC-Regular.ttf</file>
        <file>fonts/OFL-Sarasa.txt</file>
        <file>stylesheet_dark.qss</file>
        <file>stylesheet_light.qss</file>
        <file>stylesheet_tabs.qss</file>
        <file>icon_run.svg</file>
        <file>icon_save.svg</file>
        <file>icon_add.svg</file>
        <file>icon_delete.svg</file>
        <file>icon_settings.svg</file>
        <file>icon_refresh.svg</file>
        <file>icon_preview.svg</file>
        <file>icon_copy.svg</file>
        <file>icon_check.svg</file>
        <file>icon_select_all.svg</file>
        <file>icon_deselect_all.svg</file>
        <file>close_light.svg</file>
        <file>close_dark.svg</file>
        <file>icon_close.svg</file>
        <file>icon_chevron_left.svg</file>
        <file>icon_chevron_right.svg</file>
        <file>icon_folder.svg</file>
        <file>icon_terminal.svg</file>
        <file>spinbox_up.svg</file>
        <file>spinbox_down.svg</file>
        <file>spinbox_up_light.svg</file>
        <file>spinbox_down_light.svg</file>
    </qresource>
    <qresource prefix="/classic">
        <file alias="checked_image.png">../css/checked_image.png</file>
        <file alias="unchecked_image.png">../css/unchecked_image.png</file>
        <file alias="close-button.png">../css/close-button.png</file>
        <file alias="close-button_hover.png">../css/close-button_hover.png</file>
        <file alias="lose-button_pressed.png">../css/lose-button_pressed.png</file>
        <file>drop-down.svg</file>
    </qresource>
</RCC>

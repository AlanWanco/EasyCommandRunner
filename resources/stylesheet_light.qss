/* Light Theme Stylesheet - Ultra Modern (macOS / Web-like) */

* {
    font-family: ".AppleSystemUIFont", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #111827;
}

*:focus {
    outline: none;
}

QMainWindow {
    background-color: #F3F4F6;
}

QDialog {
    background-color: #F3F4F6;
}

/* Central widget and all plain QWidget containers get light bg */
QWidget {
    background-color: transparent;
    color: #111827;
}

/* Explicit backgrounds for containers that must be white/light */
QMainWindow > QWidget {
    background-color: #F3F4F6;
}

QDialog > QWidget {
    background-color: #F3F4F6;
}

/* Tab page content (CommandTab) gets white background */
QTabWidget::pane > QWidget {
    background-color: #FFFFFF;
}

/* Scroll area viewport needs explicit background */
QAbstractScrollArea {
    background-color: transparent;
}

QAbstractScrollArea > QWidget {
    background-color: transparent;
}

/* Tabs */
QTabWidget {
    background-color: transparent;
}

QTabWidget::pane {
    border: 1px solid #E5E7EB;
    background-color: #FFFFFF;
    border-radius: 8px;
    margin-top: -1px; /* hide top border under tabs */
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: #F3F4F6;
    color: #6B7280;
    padding: 5px 4px 5px 8px;
    min-width: 80px;
    max-width: 200px;
    border: 1px solid transparent;
    border-bottom: 2px solid #E5E7EB;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 1px solid #E5E7EB;
    border-bottom: 2px solid #2563EB;
}

QTabBar::tab:hover:!selected {
    background-color: #E5E7EB;
    color: #374151;
}

QTabBar::close-button {
    image: none;
    subcontrol-position: right;
    width: 0px;
    height: 0px;
}

/* Tab close button (set programmatically in C++) */
QPushButton#tabCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    margin-right: 10px;
    margin-left: 2px;
}

QPushButton#tabCloseBtn:hover {
    background-color: #E5E7EB;
}

/* Labels */
QLabel {
    color: #4B5563;
    font-size: 13px;
    font-weight: 500;
    padding: 0px;
    background: transparent;
    border: none;
}

/* Line Edits */
QLineEdit {
    color: #111827;
    background-color: #FFFFFF;
    padding: 6px 10px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    selection-background-color: #BFDBFE;
}

QLineEdit:focus {
    border: 1px solid #3B82F6;
    background-color: #FFFFFF;
}

/* Text Edits */
QTextEdit {
    color: #111827;
    background-color: #FFFFFF;
    padding: 8px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    selection-background-color: #BFDBFE;
}

QTextEdit:focus {
    border: 1px solid #3B82F6;
}

/* Buttons */
QPushButton {
    color: #374151;
    background-color: #FFFFFF;
    padding: 6px 12px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}

QPushButton:pressed {
    background-color: #F3F4F6;
    border-color: #D1D5DB;
}

QPushButton:disabled {
    color: #9CA3AF;
    background-color: #F3F4F6;
    border-color: #E5E7EB;
}

/* Primary/Special Buttons */
QPushButton#runBtn {
    background-color: #10B981;
    border: 1px solid #059669;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#runBtn:hover {
    background-color: #059669;
    border-color: #047857;
}

QPushButton#runBtn:pressed {
    background-color: #047857;
    border-color: #064E3B;
}

QPushButton#saveBtn {
    background-color: #2563EB;
    border: 1px solid #1D4ED8;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#saveBtn:hover {
    background-color: #1D4ED8;
    border-color: #1E40AF;
}

QPushButton#saveBtn:pressed {
    background-color: #1E40AF;
    border-color: #1E3A8A;
}

/* Param row check toggle button */
QPushButton#paramCheckBox {
    background-color: #FFFFFF;
    border: 1.5px solid #9CA3AF;
    border-radius: 4px;
    padding: 0px;
    margin: 0px;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    font-size: 0px;
    image: none;
}

QPushButton#paramCheckBox:hover {
    border-color: #6B7280;
    background-color: #F9FAFB;
}

QPushButton#paramCheckBox:checked {
    background-color: #2563EB;
    border: 1.5px solid #1D4ED8;
    image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><polyline points='3,8 6.5,12 13,4' fill='none' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/></svg>");
}

QPushButton#paramCheckBox:checked:hover {
    background-color: #1D4ED8;
    border-color: #1E40AF;
}

/* Combo Box */
QComboBox {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    padding: 6px 10px;
    border-radius: 6px;
}

QComboBox:focus {
    border: 1px solid #3B82F6;
}

/* Tab selector combo in corner - tighter */
QComboBox#tabCombo {
    padding: 4px 8px;
    min-width: 120px;
    margin: 4px 6px 4px 0px;
}

/* Dropdown list */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    outline: none;
    selection-background-color: #F3F4F6;
    selection-color: #111827;
}

QComboBox QAbstractItemView::item {
    padding: 4px 12px;
    min-height: 24px;
    color: #374151;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #F3F4F6;
    color: #111827;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #D1D5DB;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9CA3AF;
}

/* Menu */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 24px;
    color: #374151;
}

QMenu::item:selected {
    background-color: #F3F4F6;
    color: #111827;
}

QMenu::separator {
    background-color: #E5E7EB;
    height: 1px;
    margin: 4px 0px;
}

/* Groupbox */
QGroupBox {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #4B5563;
    font-weight: 600;
    left: 8px;
}

/* ScrollArea */
QScrollArea {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background-color: #FFFFFF;
}

/* Params scroll area - subtle inset background */
QScrollArea#paramsScrollArea {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    background-color: #F9FAFB;
}

QScrollArea#paramsScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QSplitter#paramContentSplitter {
    background-color: transparent;
}

QSplitter#paramContentSplitter::handle:vertical {
    background-color: transparent;
    height: 10px;
    margin: 2px 0px;
}

QSplitter#paramContentSplitter::handle:vertical:hover {
    background-color: rgba(37, 99, 235, 0.10);
}

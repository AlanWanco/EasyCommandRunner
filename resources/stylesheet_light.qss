/* Light Theme Stylesheet - Modern Design */

* {
    padding: 5px;
    font-family: 'Microsoft YaHei', 'SF Pro Display', sans-serif;
    background-color: #fafafa;
    font-size: 14px;
    color: #212121;
}

*:focus {
    outline: none;
}

QMainWindow {
    background-color: #ffffff;
}

QWidget {
    background-color: #ffffff;
    border-radius: 5px;
}

QTabWidget {
    background-color: #ffffff;
    padding: 5px;
    border-radius: 5px;
}

QTabBar {
    background-color: #f5f5f5;
    border-bottom: 2px solid #e0e0e0;
}

QTabBar::tab {
    background-color: #ffffff;
    font-size: 13px;
    color: #757575;
    padding: 10px 20px;
    border: none;
    font-family: 'Microsoft YaHei';
    margin: 0px 2px 0px 0px;
    border-bottom: 3px solid transparent;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1976d2;
    border-bottom: 3px solid #1976d2;
}

QTabBar::tab:!selected {
    background-color: #ffffff;
    color: #757575;
}

QTabBar::tab:hover:!selected {
    background-color: #fafafa;
    color: #424242;
}

QTabBar::close-button {
    image: url(:/res/close-button-light.png);
    subcontrol-position: right;
    margin: 0 5px;
}

QTabWidget::pane {
    border: none;
}

/* Labels */
QLabel {
    color: #212121;
    background-color: #fafafa;
    padding: 5px;
    border: 1px solid #e0e0e0;
    font-family: 'Microsoft YaHei';
    font-size: 14px;
    border-radius: 3px;
}

/* Line Edits */
QLineEdit {
    color: #212121;
    background-color: #ffffff;
    padding: 8px;
    border: 1px solid #d0d0d0;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 13px;
    border-radius: 3px;
    selection-background-color: #bbdefb;
}

QLineEdit:focus {
    border: 1px solid #1976d2;
    background-color: #fafafa;
}

/* Text Edits */
QTextEdit {
    background-color: #ffffff;
    padding: 8px;
    border-radius: 3px;
    font-size: 13px;
    border: 1px solid #d0d0d0;
    font-family: 'Consolas', 'Monaco', monospace;
    color: #212121;
    selection-background-color: #bbdefb;
}

QTextEdit:focus {
    border: 1px solid #1976d2;
    background-color: #fafafa;
}

/* Buttons */
QPushButton {
    color: #212121;
    background-color: #f5f5f5;
    padding: 8px 15px;
    border: 1px solid #d0d0d0;
    font-family: 'Microsoft YaHei';
    font-size: 13px;
    border-radius: 4px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #eeeeee;
    border-color: #bdbdbd;
}

QPushButton:pressed {
    background-color: #e0e0e0;
    border-color: #d0d0d0;
}

QPushButton:disabled {
    color: #bdbdbd;
    background-color: #f5f5f5;
    border-color: #e0e0e0;
}

/* Run Button Special Style */
QPushButton#runBtn {
    background-color: #4caf50;
    border: 1px solid #45a049;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#runBtn:hover {
    background-color: #45a049;
    border-color: #3d8b40;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #45a049, stop:1 #4caf50);
}

QPushButton#runBtn:pressed {
    background-color: #3d8b40;
    border-color: #2d5a2d;
}

/* Save Button Special Style */
QPushButton#saveBtn {
    background-color: #2196f3;
    border: 1px solid #1976d2;
    color: #ffffff;
}

QPushButton#saveBtn:hover {
    background-color: #1976d2;
    border-color: #1565c0;
}

QPushButton#saveBtn:pressed {
    background-color: #1565c0;
    border-color: #0d47a1;
}

/* Checkboxes */
QCheckBox {
    color: #212121;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 3px;
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #1976d2;
    border: 1px solid #1565c0;
    image: url(:/res/checked-light.png);
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #1976d2;
    background-color: #f5f5f5;
}

/* Combo Box */
QComboBox {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #d0d0d0;
    padding: 6px 8px;
    border-radius: 4px;
    font-size: 13px;
}

QComboBox:focus {
    border: 1px solid #1976d2;
    background-color: #fafafa;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #d0d0d0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #f5f5f5;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0px;
    height: 0px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #212121;
    border: 1px solid #d0d0d0;
    selection-background-color: #bbdefb;
    border-radius: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    height: 28px;
    background-color: #ffffff;
    border-radius: 3px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f5f5f5;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #bbdefb;
    border-radius: 3px;
}

QListView::item {
    padding: 6px 8px;
    background: #ffffff;
    border-radius: 3px;
}

QListView::item:selected {
    background-color: #bbdefb;
    border-radius: 3px;
    padding: 6px 8px;
}

QListView::item:hover {
    background-color: #f5f5f5;
    border-radius: 3px;
    padding: 6px 8px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #bdbdbd;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9e9e9e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #f5f5f5;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #bdbdbd;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9e9e9e;
}

/* Menu */
QMenu {
    color: #212121;
    font-size: 13px;
    font-family: 'Microsoft YaHei';
    background-color: #ffffff;
    padding: 2px;
    border: 1px solid #d0d0d0;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #bbdefb;
    border-radius: 2px;
}

QMenu::separator {
    background-color: #d0d0d0;
    height: 1px;
    margin: 3px 0px;
}

/* Tooltips */
QToolTip {
    background-color: #f5f5f5;
    border: 1px solid #d0d0d0;
    color: #212121;
    padding: 3px 6px;
    border-radius: 3px;
}

/* Dialog */
QDialog {
    background-color: #ffffff;
}

/* Splitter */
QSplitter::handle {
    background-color: #d0d0d0;
}

QSplitter::handle:hover {
    background-color: #1976d2;
}

/* Groupbox */
QGroupBox {
    color: #212121;
    border: 1px solid #d0d0d0;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
}

/* Dark Theme Stylesheet */

* {
    padding: 5px;
    font-family: 'Microsoft YaHei', 'SF Pro Display', sans-serif;
    background-color: #181818;
    font-size: 14px;
    color: #f5f5f5;
}

*:focus {
    outline: none;
}

QMainWindow {
    background-color: #121414;
}

QWidget {
    background-color: #121414;
    border-radius: 5px;
}

QTabWidget {
    background-color: #121414;
    padding: 5px;
    border-radius: 5px;
}

QTabBar {
    background-color: #0a0a0a;
    border-bottom: 2px solid #1e2228;
}

QTabBar::tab {
    background-color: #1a1a1a;
    font-size: 13px;
    color: #a0a0a0;
    padding: 10px 20px;
    border: none;
    font-family: 'Microsoft YaHei';
    margin: 0px 2px 0px 0px;
    border-bottom: 3px solid transparent;
    transition: all 0.2s;
}

QTabBar::tab:selected {
    background-color: #121414;
    color: #f5f5f5;
    border-bottom: 3px solid #2a7fd4;
}

QTabBar::tab:!selected {
    background-color: #1a1a1a;
    color: #a0a0a0;
}

QTabBar::tab:hover:!selected {
    background-color: #252525;
    color: #d0d0d0;
}

QTabBar::close-button {
    image: url(:/res/close-button.png);
    subcontrol-position: right;
    margin: 0 5px;
}

QTabWidget::pane {
    border: none;
}

/* Labels */
QLabel {
    color: #f5f5f5;
    background-color: #181a1a;
    padding: 5px;
    border: 1px solid #1e2228;
    font-family: 'Microsoft YaHei';
    font-size: 14px;
    border-radius: 3px;
}

/* Line Edits */
QLineEdit {
    color: #f5f5f5;
    background-color: #181818;
    padding: 8px;
    border: 1px solid #1e2228;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 13px;
    border-radius: 3px;
    selection-background-color: #1a5490;
}

QLineEdit:focus {
    border: 1px solid #2a7fd4;
}

/* Text Edits */
QTextEdit {
    background-color: #181818;
    padding: 8px;
    border-radius: 3px;
    font-size: 13px;
    border: 1px solid #1e2228;
    font-family: 'Consolas', 'Monaco', monospace;
    color: #f5f5f5;
    selection-background-color: #1a5490;
}

QTextEdit:focus {
    border: 1px solid #2a7fd4;
}

/* Buttons */
QPushButton {
    color: #f5f5f5;
    background-color: #1a1a1a;
    padding: 8px 15px;
    border: 1px solid #2a2a2a;
    font-family: 'Microsoft YaHei';
    font-size: 13px;
    border-radius: 4px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #252525;
    border-color: #3a3a3a;
}

QPushButton:pressed {
    background-color: #323232;
    border-color: #2a2a2a;
}

QPushButton:disabled {
    color: #707070;
    background-color: #0f0f0f;
    border-color: #1a1a1a;
}

/* Run Button Special Style */
QPushButton#runBtn {
    background-color: #1a4d2e;
    border: 1px solid #2a7f3f;
    color: #ffffff;
}

QPushButton#runBtn:hover {
    background-color: #1f5a36;
    border-color: #3a9f5f;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1f5a36, stop:1 #1a4d2e);
}

QPushButton#runBtn:pressed {
    background-color: #194628;
    border-color: #2a7f3f;
}

/* Save Button Special Style */
QPushButton#saveBtn {
    background-color: #1a3a52;
    border: 1px solid #1a5a82;
    color: #ffffff;
}

QPushButton#saveBtn:hover {
    background-color: #1f4466;
    border-color: #2a7fa2;
}

QPushButton#saveBtn:pressed {
    background-color: #18304a;
    border-color: #1a5a82;
}

/* Checkboxes */
QCheckBox {
    color: #f5f5f5;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 3px;
    border: 1px solid #1e2228;
    background-color: #181818;
}

QCheckBox::indicator:checked {
    background-color: #1a263b;
    border: 1px solid #2a7fd4;
    image: url(:/res/checked.png);
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #2a7fd4;
}

/* Combo Box */
QComboBox {
    background-color: #1a1a1a;
    color: #f5f5f5;
    border: 1px solid #2a2a2a;
    padding: 6px 8px;
    border-radius: 4px;
    font-size: 13px;
}

QComboBox:focus {
    border: 1px solid #2a7fd4;
    background-color: #1e1e1e;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #2a2a2a;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #0f0f0f;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0px;
    height: 0px;
}

QComboBox QAbstractItemView {
    background-color: #141414;
    color: #f5f5f5;
    border: 1px solid #2a2a2a;
    selection-background-color: #2a7fd4;
    border-radius: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    height: 28px;
    background-color: #141414;
    border-radius: 3px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #252525;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #2a7fd4;
    border-radius: 3px;
}

QListView::item {
    padding: 6px 8px;
    background: #141414;
    border-radius: 3px;
}

QListView::item:selected {
    background-color: #2a7fd4;
    border-radius: 3px;
    padding: 6px 8px;
}

QListView::item:hover {
    background-color: #252525;
    border-radius: 3px;
    padding: 6px 8px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #1e2228;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #707070;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #888888;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #1e2228;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #707070;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #888888;
}

/* Menu */
QMenu {
    color: #f5f5f5;
    font-size: 13px;
    font-family: 'Microsoft YaHei';
    background-color: #1a1a1a;
    padding: 2px;
    border: 1px solid #1e2228;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #1a5490;
    border-radius: 2px;
}

QMenu::separator {
    background-color: #1e2228;
    height: 1px;
    margin: 3px 0px;
}

/* Tooltips */
QToolTip {
    background-color: #2a2a2a;
    border: 1px solid #1e2228;
    color: #f5f5f5;
    padding: 3px 6px;
    border-radius: 3px;
}

/* Dialog */
QDialog {
    background-color: #121414;
}

/* Splitter */
QSplitter::handle {
    background-color: #1e2228;
}

QSplitter::handle:hover {
    background-color: #2a7fd4;
}

/* Groupbox */
QGroupBox {
    color: #f5f5f5;
    border: 1px solid #1e2228;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
}

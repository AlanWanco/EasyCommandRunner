/* Classic near-black palette, modern spacing and restrained accents. */
* {
    font-family: ".AppleSystemUIFont", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: __ECR_FONT_SIZE__px;
    font-weight: __ECR_FONT_WEIGHT__;
    color: #e2e4e5;
}
*:focus { outline: none; }
QWidget { background: transparent; }
QMainWindow, QDialog { background: #121414; }
/* Header dimensions are shared in stylesheet_tabs.qss. */
QTabWidget::pane { border-color: #282c2e; background: #151717; }
/* 滚动按钮必须不透明，否则后面的标签关闭图标会透到 ← → 上。 */
QTabBar QToolButton {
    background: #202323; color: #e2e4e5; border-color: #343839;
}
QTabBar QToolButton:hover { background: #343838; }
QTabBar QToolButton:disabled { background: #202323; color: #626c70; }
QTabBar::tab {
    background: #1b1d1d;
    color: #a7adaf;
    border-color: #282c2e;
}
QTabBar::tab:selected { background: #343838; color: #f5f5f5; }
QTabBar::tab:hover:!selected { background: #242727; color: #e2e4e5; }
QTabBar::close-button { image: url(:/classic/close-button.png); }
QTabBar::close-button:hover { image: url(:/classic/close-button_hover.png); }
QTabBar::close-button:pressed { image: url(:/classic/lose-button_pressed.png); }
QLabel { color: #b9bfc1; padding: 0; border: none; }
QLabel[role="section"] { color: #e2e4e5; font-weight: __ECR_FONT_WEIGHT__; padding-top: 4px; }
QLabel[role="hint"] { color: #8b9498; font-size: __ECR_SMALL_FONT_SIZE__px; }
QLineEdit, QTextEdit, QPlainTextEdit {
    background: #181818;
    border: 1px solid #303436;
    border-radius: 5px;
    padding: 7px 9px;
    color: #f0f1f2;
    selection-background-color: #344454;
    selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: #667985; }
QLineEdit:disabled { color: #777f83; background: #151717; border-color: #25292b; }
QLineEdit#programEdit, QLineEdit#paramFuncEdit, QLineEdit#paramValueEdit,
QLineEdit#otherArgsEdit, QTextEdit#commandPreviewEdit, QPlainTextEdit#runLogOutput {
    font-family: __ECR_CODE_FONT_FAMILY__;
    font-size: __ECR_SMALL_FONT_SIZE__px;
    font-weight: __ECR_FONT_WEIGHT__;
}
QTextEdit#commandPreviewEdit { background: #111313; color: #c1cdd2; }
QPushButton {
    background: #202323;
    border: 1px solid #343839;
    border-radius: 5px;
    padding: 7px 12px;
    color: #e2e4e5;
}
QPushButton:hover { background: #2b2f2f; border-color: #535b5e; }
QPushButton:pressed { background: #161919; }
QPushButton:focus { border-color: #7a8b93; }
QPushButton:disabled { color: #626c70; border-color: #252a2b; background: #171a1a; }
QPushButton#runBtn { background: #1a263b; border-color: #344962; color: #edf3fa; padding: 8px 20px; }
QPushButton#runBtn:hover { background: #233350; border-color: #5b718a; }
QPushButton#runBtn:pressed { background: #182337; }
QPushButton#saveBtn { background: #2a3030; border-color: #4b5659; }
QPushButton[role="nav"] { background: transparent; border: none; padding: 0; border-radius: 8px; }
QPushButton[role="nav"]:hover { background: #282e30; }
QPushButton[role="nav"]:focus { border: 1px solid #667985; }
QPushButton[role="icon"] { padding: 5px; }
QPushButton#paramRemoveBtn { background: transparent; border-color: transparent; }
QPushButton#paramRemoveBtn:hover { background: #382b2b; border-color: #634848; }
QPushButton#paramCheckBox { background: transparent; border: none; padding: 0; margin: 0; }
QComboBox {
    background: #1b1d1d; border: 1px solid #343839; border-radius: 5px;
    padding: 6px 24px 6px 9px; color: #d0d5d7;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow { image: url(:/classic/drop-down.svg); width: 8px; height: 5px; }
QComboBox QAbstractItemView {
    background: #1b1e1e;
    border: 1px solid #424849;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 4px 0;
    selection-background-color: #343c3e;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; min-height: 24px; }
QListView::item { padding: 6px 10px; }
QListView::item:selected, QListView::item:hover { background: #343c3e; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: #151818; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #424a4d; min-height: 24px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #657176; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: none; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QMenu {
    background: #181b1b;
    border: 1px solid #303738;
    border-radius: 8px;
    color: #e2e4e5;
    padding: 4px 0;
}
QMenuBar {
    background: #181b1b;
    border: none;
    color: #e2e4e5;
    padding: 2px 4px;
}
QMenuBar::item { padding: 6px 10px; border-radius: 5px; }
QMenuBar::item:selected { background: #30393c; }
QMenu::item { padding: 7px 24px; color: #e2e4e5; }
QMenu::item:selected { background: #30393c; }
QMenu::item:disabled { color: #697477; }
QMenu::separator { height: 1px; background: #343a3c; margin: 4px 8px; }
QToolTip { background: #343c40; color: #f5f5f5; border: 1px solid #586267; padding: 5px; }
QGroupBox { border: 1px solid #303738; border-radius: 6px; margin-top: 16px; padding: 16px 10px 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; }
QDockWidget { background: #121414; border: 1px solid #303738; }
QDockWidget::title { background: #1b1e1e; padding: 6px 10px; }
QStatusBar { background: #121414; color: #8b9498; font-size: __ECR_SMALL_FONT_SIZE__px; }
QStatusBar::item { border: none; }
QSpinBox, QAbstractSpinBox {
    color: #e2e4e5;
    background: #181818;
    border: 1px solid #343839;
    border-radius: 5px;
    padding: 5px 24px 5px 8px;
}
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    right: 1px;
    width: 20px;
    background: #202323;
    border-left: 1px solid #343839;
}
QSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 4px; }
QSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 4px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #343838; }
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed { background: #161919; }
QSpinBox::up-arrow { image: url(:/res/spinbox_up.svg); width: 8px; height: 5px; }
QSpinBox::down-arrow { image: url(:/res/spinbox_down.svg); width: 8px; height: 5px; }
QSpinBox:focus, QAbstractSpinBox:focus { border-color: #667985; }

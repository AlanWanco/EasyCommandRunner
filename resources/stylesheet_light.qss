/* Light Theme Stylesheet - Ultra Modern (macOS / Web-like) */

* {
    font-family: ".AppleSystemUIFont", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: __ECR_FONT_SIZE__px;
    font-weight: __ECR_FONT_WEIGHT__;
    color: #111827;
}

*:focus {
    outline: none;
}

QMainWindow {
    background-color: #F3F4F6;
}

QDialog {
    background-color: #F3F4F6;
}

/* Central widget and all plain QWidget containers get light bg */
QWidget {
    background-color: transparent;
    color: #111827;
}

/* Explicit backgrounds for containers that must be white/light */
QMainWindow > QWidget {
    background-color: #F3F4F6;
}

QDialog > QWidget {
    background-color: #F3F4F6;
}

/* Tab page content (CommandTab) gets white background */
QTabWidget::pane > QWidget {
    background-color: #FFFFFF;
}

/* Scroll area viewport needs explicit background */
QAbstractScrollArea {
    background-color: transparent;
}

QAbstractScrollArea > QWidget {
    background-color: transparent;
}

/* Header dimensions are shared in stylesheet_tabs.qss. */
QTabWidget::pane { border-color: #E5E7EB; background-color: #FFFFFF; }
QTabBar QToolButton {
    background: #F3F4F6; color: #374151; border-color: #E5E7EB;
}
QTabBar QToolButton:hover { background: #E5E7EB; }
QTabBar QToolButton:disabled { background: #F3F4F6; color: #9CA3AF; }

QTabBar::tab {
    background-color: #F3F4F6;
    color: #6B7280;
    border-color: #E5E7EB;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2563EB;
    border-color: #E5E7EB;
}

QTabBar::tab:hover:!selected {
    background-color: #E5E7EB;
    color: #374151;
}

QTabBar::close-button {
    image: url(:/res/close_light.svg);
}

/* Tab close button (set programmatically in C++) */
QPushButton#tabCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    margin-right: 10px;
    margin-left: 2px;
}

QPushButton#tabCloseBtn:hover {
    background-color: #E5E7EB;
}

/* Labels */
QLabel {
    color: #4B5563;
    font-size: __ECR_FONT_SIZE__px;
    font-weight: __ECR_FONT_WEIGHT__;
    padding: 0px;
    background: transparent;
    border: none;
}

/* Line Edits */
QLineEdit {
    color: #111827;
    background-color: #FFFFFF;
    padding: 6px 10px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    selection-background-color: #BFDBFE;
}

QLineEdit:focus {
    border: 1px solid #3B82F6;
    background-color: #FFFFFF;
}

/* Text Edits */
QTextEdit {
    color: #111827;
    background-color: #FFFFFF;
    padding: 8px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    selection-background-color: #BFDBFE;
}

QTextEdit:focus {
    border: 1px solid #3B82F6;
}

/* Buttons */
QPushButton {
    color: #374151;
    background-color: #FFFFFF;
    padding: 6px 12px;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    font-weight: __ECR_FONT_WEIGHT__;
}

QPushButton:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}

QPushButton:pressed {
    background-color: #F3F4F6;
    border-color: #D1D5DB;
}

QPushButton:disabled {
    color: #9CA3AF;
    background-color: #F3F4F6;
    border-color: #E5E7EB;
}

/* Primary/Special Buttons */
QPushButton#runBtn {
    background-color: #10B981;
    border: 1px solid #059669;
    color: #FFFFFF;
    font-weight: __ECR_FONT_WEIGHT__;
}

QPushButton#runBtn:hover {
    background-color: #059669;
    border-color: #047857;
}

QPushButton#runBtn:pressed {
    background-color: #047857;
    border-color: #064E3B;
}

QPushButton#saveBtn {
    background-color: #2563EB;
    border: 1px solid #1D4ED8;
    color: #FFFFFF;
    font-weight: __ECR_FONT_WEIGHT__;
}

QPushButton#saveBtn:hover {
    background-color: #1D4ED8;
    border-color: #1E40AF;
}

QPushButton#saveBtn:pressed {
    background-color: #1E40AF;
    border-color: #1E3A8A;
}

/* Param row check toggle button */
QPushButton#paramCheckBox {
    background-color: #FFFFFF;
    border: 1.5px solid #9CA3AF;
    border-radius: 4px;
    padding: 0px;
    margin: 0px;
    min-width: 31px;
    max-width: 31px;
    min-height: 23px;
    max-height: 23px;
    font-size: __ECR_LARGE_FONT_SIZE__px;
    image: none;
}

QPushButton#paramCheckBox:hover {
    border-color: #6B7280;
    background-color: #F9FAFB;
}

QPushButton#paramCheckBox:checked {
    background-color: #2563EB;
    border: 1.5px solid #1D4ED8;
    image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><polyline points='3,8 6.5,12 13,4' fill='none' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/></svg>");
}

QPushButton#paramCheckBox:checked:hover {
    background-color: #1D4ED8;
    border-color: #1E40AF;
}

/* Combo Box */
QComboBox {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    padding: 6px 10px;
    border-radius: 6px;
}

QComboBox:focus {
    border: 1px solid #3B82F6;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: url(:/classic/drop-down.svg);
    width: 8px;
    height: 5px;
}

/* Dropdown list: the popup is a separate window, so style the view itself too. */
QAbstractItemView {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 4px 0;
    outline: none;
    selection-background-color: #E8EEF8;
    selection-color: #111827;
}

QAbstractItemView::item {
    padding: 4px 12px;
    min-height: 24px;
    color: #374151;
}

QAbstractItemView::item:selected,
QAbstractItemView::item:hover {
    background-color: #F3F4F6;
    color: #111827;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #D1D5DB;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9CA3AF;
}

/* Menu */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 4px 0px;
    color: #111827;
}

QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
    padding: 2px 4px;
    color: #374151;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #E8EEF8;
    color: #111827;
}

QMenu::item {
    padding: 7px 24px;
    color: #374151;
}

QMenu::item:selected {
    background-color: #E8EEF8;
    color: #111827;
}

QMenu::item:disabled {
    color: #9CA3AF;
}

QMenu::separator {
    background-color: #E5E7EB;
    height: 1px;
    margin: 4px 8px;
}

/* Groupbox */
QGroupBox {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #4B5563;
    font-weight: __ECR_FONT_WEIGHT__;
    left: 8px;
}

/* ScrollArea */
QScrollArea {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background-color: #FFFFFF;
}

/* Params scroll area - subtle inset background */
QScrollArea#paramsScrollArea {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    background-color: #F9FAFB;
}

QScrollArea#paramsScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QSplitter#paramContentSplitter {
    background-color: transparent;
}

QSplitter#paramContentSplitter::handle:vertical {
    background-color: transparent;
    height: 10px;
    margin: 2px 0px;
}

QSplitter#paramContentSplitter::handle:vertical:hover {
    background-color: rgba(37, 99, 235, 0.10);
}

/* Components shared by the log dock, settings dialog and native-looking controls */
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: #9CA3AF;
    background-color: #F3F4F6;
    border-color: #E5E7EB;
}

QLineEdit#programEdit, QLineEdit#paramFuncEdit, QLineEdit#paramValueEdit,
QLineEdit#otherArgsEdit, QTextEdit#commandPreviewEdit, QPlainTextEdit#runLogOutput {
    font-family: __ECR_CODE_FONT_FAMILY__;
    font-size: __ECR_SMALL_FONT_SIZE__px;
    font-weight: __ECR_FONT_WEIGHT__;
}

QTextEdit#commandPreviewEdit, QPlainTextEdit#runLogOutput {
    background-color: #F9FAFB;
    color: #1F2937;
    selection-background-color: #BFDBFE;
}

QPushButton[role="nav"] {
    background-color: transparent;
    border: none;
    padding: 0;
    border-radius: 8px;
}
QPushButton[role="nav"]:hover { background-color: #E5E7EB; }
QPushButton[role="nav"]:focus { border: 1px solid #93C5FD; }
QPushButton[role="icon"] { padding: 5px; }
QPushButton#paramRemoveBtn { background-color: transparent; border-color: transparent; }
QPushButton#paramRemoveBtn:hover { background-color: #FEE2E2; border-color: #FCA5A5; }

QDockWidget {
    background-color: #F3F4F6;
    border: 1px solid #D1D5DB;
}
QStatusBar {
    background-color: #F3F4F6;
    color: #6B7280;
}
QStatusBar::item { border: none; }
QToolTip {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    padding: 5px;
}

QSpinBox, QAbstractSpinBox {
    color: #111827;
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 5px 24px 5px 8px;
}
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    right: 1px;
    width: 20px;
    background: #F3F4F6;
    border-left: 1px solid #D1D5DB;
}
QSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 5px; }
QSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 5px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #E5E7EB; }
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed { background: #D1D5DB; }
QSpinBox::up-arrow { image: url(:/res/spinbox_up_light.svg); width: 8px; height: 5px; }
QSpinBox::down-arrow { image: url(:/res/spinbox_down_light.svg); width: 8px; height: 5px; }
QSpinBox:focus, QAbstractSpinBox:focus { border-color: #3B82F6; }
